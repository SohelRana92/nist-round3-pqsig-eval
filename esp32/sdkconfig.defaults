# sdkconfig.defaults for the PQC signature benchmark (ESP-IDF 5.x).
# Applied when idf.py creates sdkconfig. Delete sdkconfig to re-apply.

# Highest supported core clock (ESP32 and ESP32-S3: 240 MHz).
# ESP32-C3 and ESP32-C6 top out at 160 MHz: change this line for them.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Long operations must not trip the task watchdog.
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_TASK_WDT_INIT=n

# The console stays at the ESP-IDF default of 115200 baud. (A custom rate
# needs CONFIG_ESP_CONSOLE_UART_CUSTOM=y; the result lines are printed
# between timed runs, so the slower console does not change any timing.)

# Wi-Fi and Bluetooth stay off: the project never starts them.
CONFIG_BT_ENABLED=n

# Main task only creates the benchmark task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Boards with PSRAM (WROVER modules): uncomment the three lines so large keys
# and, when no internal block is big enough, the benchmark task's stack can
# live in PSRAM. The harness prints NOTE,alloc_in_psram and
# NOTE,task_stack_in_psram when it uses it. Leave them commented on boards
# without PSRAM: the firmware stops at boot if PSRAM is enabled but absent.
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_USE_MALLOC=y
# CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# The scheme code is built with NDEBUG, as on Linux. ESP-IDF would still
# evaluate the expression inside assert() under NDEBUG, which breaks code
# whose assert() names debug-only variables (FAEST). Make it a no-op.
CONFIG_COMPILER_ASSERT_NDEBUG_EVALUATE=n

# Optimise ESP-IDF itself for speed too (default is -Og), so library calls
# made from the schemes are not run as debug builds.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Some schemes (FAEST) exceed the default 1 MB app partition: use the
# 1.5 MB single-app layout, which fits any ESP32 with 2 MB of flash or more.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
